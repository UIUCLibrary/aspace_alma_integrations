# Copy this file to .env and edit. .env is gitignored; this file is not, so
# never put a real password or API key here.
#
#   cp docker/.env.example docker/.env

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# Set this to the version of the server you are mirroring, NOT to the newest
# release. ArchivesSpace publishes its Solr image in lockstep under the same
# tag, so one setting covers both and the Solr configset always matches the
# application.
#
# Matching the source server matters in both directions:
#
#   Too old  -- ArchivesSpace migrates forward only, so a dump from a newer
#               release will not load at all.
#   Too new  -- it starts, but the first boot MIGRATES YOUR DATA to the newer
#               schema. It works, and it is a one-way change to your local
#               copy, which no longer reflects what staging actually runs.
#
# The UIUC staging server is currently 4.1.1, hence the default below.
#
# Verified available 4.x tags (both images): 4.0.0, 4.1.0, 4.1.1, 4.2.0, 4.2.1
#
# Changing this after you have already started requires ./scripts/up.sh
# --fresh: the existing database has been migrated to the old setting's schema
# and the Solr index may have been touched by a newer Lucene. up.sh checks for
# this and tells you if it applies.
ASPACE_VERSION=4.1.1
MYSQL_VERSION=8.0

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------
# Verified against Docker Hub: archivesspace/archivesspace and
# archivesspace/solr are published for linux/amd64 ONLY -- there is no arm64
# build. On your M2 this therefore runs under Rosetta emulation: slower to
# start, but it works. Pinning it also keeps behaviour identical between the
# Mac and an amd64 CI runner, which is the point when debugging.
ASPACE_PLATFORM=linux/amd64

# The database is deliberately separate, because mysql DOES publish
# linux/arm64v8. Leaving this empty lets Docker choose, so MySQL runs natively
# on Apple Silicon instead of being emulated -- which matters a lot, since
# importing a dump is the slowest part of a first start and emulation punishes
# exactly that kind of CPU- and IO-heavy work.
#
# Set it to linux/amd64 only if you are deliberately reproducing an
# architecture-specific database problem. Doing so costs you a lot of import
# time. If you change it after the fact, run ./scripts/up.sh --fresh: the data
# directory is written by the server that created it and should not be handed
# to a different build.
DB_PLATFORM=

# ---------------------------------------------------------------------------
# Ports on the host
# ---------------------------------------------------------------------------
# Change these if something already has the port. ASpace's own config must
# agree, which docker/config/config.rb.example handles.
STAFF_PORT=8080
PUBLIC_PORT=8081
BACKEND_PORT=8089
OAI_PORT=8082
SOLR_PORT=8983
MYSQL_PORT=3306

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local-only credentials for a container on your laptop. They do not need to
# match the credentials on the server you copied the dump from: MySQL creates
# this database and user, then applies your dump into it.
#
# MYSQL_DATABASE must match the database the dump expects. ArchivesSpace dumps
# normally carry no CREATE DATABASE/USE statement, so the default below is
# almost always right; only change it if your dump names a database explicitly.
MYSQL_DATABASE=archivesspace
MYSQL_USER=as
MYSQL_PASSWORD=as123
MYSQL_ROOT_PASSWORD=root123

# ---------------------------------------------------------------------------
# JVM memory
# ---------------------------------------------------------------------------
# 2g is comfortable for a decent-sized repository on a 16GB machine. Drop to
# 1g on an 8GB Air if things get tight; raise it if indexing a large database.
#
# Quote any value containing a space. The helper scripts source this file with
# bash, which would otherwise try to run the second word as a command.
ASPACE_JAVA_XMX="-Xmx2g"
SOLR_JAVA_MEM="-Xms512m -Xmx1g"

# ---------------------------------------------------------------------------
# Indexing
# ---------------------------------------------------------------------------
# Set to false to stop ArchivesSpace indexing into Solr. Use that when you
# have copied an index down and want it left exactly as it is; leave it true
# to have ArchivesSpace build or top up the index itself.
ASPACE_INDEXER_ENABLED=true

# ---------------------------------------------------------------------------
# Detailed error pages
# ---------------------------------------------------------------------------
# ArchivesSpace always runs Rails in production mode -- the environment is
# baked into web.xml inside the war, so it cannot be changed from outside --
# and in production a 500 shows a generic apology page while the real
# exception goes only to the log.
#
# With this on, the docker/dev_plugin plugin makes Rails render its usual
# error page instead, with the exception, the backtrace and the offending
# source lines. That is normally what you want while working on the plugin.
#
# It is deliberately scoped to this local stack: the plugin that does it lives
# under docker/ and is never part of the plugin ArchivesSpace loads in
# production, because stack traces in the browser disclose source paths and
# application internals.
#
# Set to false for the stock behaviour.
ASPACE_DEBUG_EXCEPTIONS=true
