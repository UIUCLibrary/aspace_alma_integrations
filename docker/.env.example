# Copy this file to .env and edit. .env is gitignored; this file is not, so
# never put a real password or API key here.
#
#   cp docker/.env.example docker/.env

# ---------------------------------------------------------------------------
# Versions
# ---------------------------------------------------------------------------
# Pin this to match the server you are mirroring. ArchivesSpace publishes its
# Solr image in lockstep under the same tag, so one version covers both and
# the Solr configset is guaranteed to match the application.
#
# Verified available 4.x tags: 4.0.0, 4.1.0, 4.1.1, 4.2.0, 4.2.1
ASPACE_VERSION=4.2.1
MYSQL_VERSION=8.0

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------
# Verified against Docker Hub: archivesspace/archivesspace and
# archivesspace/solr are published for linux/amd64 ONLY -- there is no arm64
# build. On your M2 this therefore runs under Rosetta emulation: slower to
# start, but it works. Pinning it also keeps behaviour identical between the
# Mac and an amd64 CI runner, which is the point when debugging.
ASPACE_PLATFORM=linux/amd64

# ---------------------------------------------------------------------------
# Ports on the host
# ---------------------------------------------------------------------------
# Change these if something already has the port. ASpace's own config must
# agree, which docker/config/config.rb.example handles.
STAFF_PORT=8080
PUBLIC_PORT=8081
BACKEND_PORT=8089
OAI_PORT=8082
SOLR_PORT=8983
MYSQL_PORT=3306

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local-only credentials for a container on your laptop. They do not need to
# match the credentials on the server you copied the dump from: MySQL creates
# this database and user, then applies your dump into it.
#
# MYSQL_DATABASE must match the database the dump expects. ArchivesSpace dumps
# normally carry no CREATE DATABASE/USE statement, so the default below is
# almost always right; only change it if your dump names a database explicitly.
MYSQL_DATABASE=archivesspace
MYSQL_USER=as
MYSQL_PASSWORD=as123
MYSQL_ROOT_PASSWORD=root123

# ---------------------------------------------------------------------------
# JVM memory
# ---------------------------------------------------------------------------
# 2g is comfortable for a decent-sized repository on a 16GB machine. Drop to
# 1g on an 8GB Air if things get tight; raise it if indexing a large database.
#
# Quote any value containing a space. The helper scripts source this file with
# bash, which would otherwise try to run the second word as a command.
ASPACE_JAVA_XMX="-Xmx2g"
SOLR_JAVA_MEM="-Xms512m -Xmx1g"

# ---------------------------------------------------------------------------
# Indexing
# ---------------------------------------------------------------------------
# Set to false to stop ArchivesSpace indexing into Solr. Use that when you
# have copied an index down and want it left exactly as it is; leave it true
# to have ArchivesSpace build or top up the index itself.
ASPACE_INDEXER_ENABLED=true
