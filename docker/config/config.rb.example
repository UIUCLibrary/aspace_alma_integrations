# Local ArchivesSpace configuration for plugin development.
#
#   cp config/config.rb.example config/config.rb
#
# config.rb is gitignored because it holds a real Alma API key. This example
# file is not, so do not put credentials in it.
#
# Anything set here overrides the APPCONFIG_* environment variables in
# docker-compose.yml, so keep database and Solr settings out of this file and
# let the compose wiring own them.

# ---------------------------------------------------------------------------
# Turn the plugin on
# ---------------------------------------------------------------------------
# The directory name must match the bind mount in docker-compose.yml. Listing
# a plugin here is what makes ArchivesSpace load its frontend controllers,
# backend job runners and schemas.
# alma_dev_errors is the development-only plugin in docker/dev_plugin that
# makes Rails render real stack traces in the browser. Drop it from this
# list if you would rather see ArchivesSpace's generic error page.
AppConfig[:plugins] = ['local', 'lcnaf', 'alma_integrations', 'alma_dev_errors']

# ---------------------------------------------------------------------------
# Alma
# ---------------------------------------------------------------------------
# Region-specific; note the URL must end in /bibs.
AppConfig[:alma_api_url] = 'https://api-na.hosted.exlibrisgroup.com/almaws/v1/bibs'

# Use a SANDBOX key while developing. A production key here means a bug in a
# bulk update job rewrites real catalogue records, and this plugin is built to
# push to Alma without asking twice. You can get a personal sandbox key from
# the Ex Libris Developer Network.
AppConfig[:alma_apikey] = 'REPLACE_WITH_YOUR_SANDBOX_KEY'

# Building and location codes used when creating holdings: [852$b, 852$c].
AppConfig[:alma_holdings] = [
  ['MAIN', 'STACKS']
]

# MARC fields carried over from the existing Alma record on push.
AppConfig[:alma_marc_fields_to_preserve] = ['035']

# Which Resource user-defined field holds the MMS ID.
AppConfig[:alma_mms_id_field] = 'string_2'

# ---------------------------------------------------------------------------
# Alma rate limiting
# ---------------------------------------------------------------------------
# Deliberately low for local work. The sandbox is shared and there is no point
# hammering it from a laptop; raise it only when testing throughput behaviour.
AppConfig[:alma_requests_per_second] = 5
AppConfig[:alma_daily_quota_floor] = 100

# Fetch fewer bibs per call locally so you can actually watch the chunking
# happen in the job log with a small test list. Production default is 100.
AppConfig[:alma_bulk_fetch_size] = 10

# Keep audit report JSON around indefinitely while developing.
AppConfig[:alma_audit_report_retention_days] = nil

# ---------------------------------------------------------------------------
# Development conveniences
# ---------------------------------------------------------------------------
# Two job threads is the ArchivesSpace default and it is worth keeping, because
# it is what the bulk jobs were designed around -- a long-running audit must
# not be able to occupy every worker. Raise it only if you are deliberately
# testing concurrency.
AppConfig[:job_thread_count] = 2

# Show full backtraces rather than a generic error page.
AppConfig[:backend_log_level] = 'debug'

# Uncomment to have ArchivesSpace reload frontend code on each request. It is
# slow, and slower still under emulation on Apple Silicon, but it saves a
# container restart per edit when you are iterating on views.
# AppConfig[:frontend_cache_classes] = false

# ---------------------------------------------------------------------------
# Mirroring a remote server
# ---------------------------------------------------------------------------
# If you restored a dump from a live server, that database may contain real
# usernames and email addresses. Nothing here emails anyone by default, but if
# you enable any notification feature locally, make sure it cannot reach out.
#
# The frontend URL must match the host port you mapped in .env, otherwise
# generated links and redirects point at the wrong place.
AppConfig[:frontend_url] = 'http://localhost:8080'
AppConfig[:public_url] = 'http://localhost:8081'
