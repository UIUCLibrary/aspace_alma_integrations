<%
  existing = results['holdings'].map { |h| [h['library'], h['code']] }
  locations = AlmaIntegrations::HoldingLocations.available(@locations || [], existing)
%>

<section id="add_holdings" class="subrecord-form-dummy">
  <h3><%= I18n.t("plugins.alma_integrations.holdings_form.heading") %></h3>
  <div class="subrecord-form-container">
    <% Array(@location_warnings).each do |warning| %>
      <div class="alert alert-warning"><%= warning %></div>
    <% end %>
    <%= form_tag({:controller => :alma_integrations, :action => :add_holdings}, {:class => "form-horizontal", :id => "add_holdings_form", :method => :post}) do |f| %>
      <input type="hidden" name="mms" value="<%= @results['mms'] %>"/>
      <input type="hidden" name="ref" value="<%= @results['ref'] %>"/>
      <div class="subrecord-form-fields">
        <div class="new-holdings-container">
          <div class="form-group">
            <label class="control-label col-sm-2"><%= I18n.t("plugins.alma_integrations.holdings_form.call_number") %></label>
            <div class="col-sm-8">
              <p class="form-control-static"><%= @call_number.presence || I18n.t("plugins.alma_integrations.holdings_form.no_call_number") %></p>
            </div>
          </div>
          <div class="form-group required">
            <label class="control-label col-sm-2" for="location"><%= I18n.t("plugins.alma_integrations.holdings_form.location") %></label>
            <div class="col-sm-8">
              <% if locations.empty? %>
                <p class="form-control-static"><%= I18n.t("plugins.alma_integrations.holdings_form.no_locations") %></p>
              <% else %>
                <select name="location" id="location" class="form-control">
                  <% locations.group_by(&:library).each do |library, group| %>
                    <optgroup label="<%= library %>">
                      <% group.each do |loc| %>
                        <option value="<%= loc.to_param %>"><%= loc.label %></option>
                      <% end %>
                    </optgroup>
                  <% end %>
                </select>
              <% end %>
            </div>
          </div>
        </div>
        <% unless locations.empty? %>
          <div class="form-group">
            <div class="controls">
              <%= submit_tag I18n.t("plugins.alma_integrations.actions.add"), :class => "btn btn-primary pull-right" %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
